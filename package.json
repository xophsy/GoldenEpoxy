{
  "name": "goldenepoxy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run gallery:build && npm run catalog:build",
    "dev": "next dev",
    "catalog:sync": "node ./scripts/sync-catalog.mjs",
    "catalog:build": "node ./scripts/generate-catalog.mjs",
    "catalog:verify": "node ./scripts/generate-catalog.mjs --verify",
    "catalog:pilot:chatgpt": "node ./scripts/chatgpt-catalog-pilot.mjs",
    "catalog:pilot:chatgpt:preflight": "node ./scripts/chatgpt-catalog-pilot.mjs --preflight",
    "gallery:build": "node ./scripts/generate-gallery.mjs",
    "gallery:verify": "node ./scripts/generate-gallery.mjs --verify",
    "prebuild": "node ./scripts/prebuild-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "framer-motion": "^12.35.2",
    "gsap": "^3.14.2",
    "next": "16.1.6",
    "photoswipe": "^5.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.22.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
